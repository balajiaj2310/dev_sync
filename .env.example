# ==============================================================================
# DevSync Production Environment Configuration Template
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production
ALLOWED_HOSTS=api.devsync.dev,app.devsync.dev,localhost,127.0.0.1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://devsync_user:devsync_password@postgres:5432/devsync_db

# Redis & Channels Layer
REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/1

# Security & CORS
CORS_ALLOWED_ORIGINS=https://app.devsync.dev,https://devsync.dev
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Google Gemini AI & Voice Live Integration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LIVE_MODEL=gemini-3.8-live

# Email (SMTP / Mailer)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-or-ses-smtp-password
DEFAULT_FROM_EMAIL=DevSync Security <security@devsync.dev>

# File Storage / AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
