# DevSync Frontend Environment Configuration Example
# Copy this file to .env when building or running through a local development server

VITE_APP_NAME="DevSync"
VITE_APP_ENV="development"
VITE_DEMO_MODE=true

# Live Django Backend API Target (Active when VITE_DEMO_MODE=false)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_WS_BASE_URL="ws://127.0.0.1:8000/ws"

# AI Assistant Provider (Optional Backend Keys)
AI_ENGINE_MODEL="claude-3-5-sonnet"
